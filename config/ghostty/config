# Ghostty terminal emulator config
#
# Shared across macOS and Linux: Ghostty reads ~/.config/ghostty/config (the
# XDG path) on both platforms, so a single symlinked file works everywhere.
#
# NOTE: on macOS Ghostty ALSO loads
#   ~/Library/Application Support/com.mitchellh.ghostty/config
# AFTER this file, so anything set there silently overrides this one. That
# file is kept intentionally empty — put every setting here. macOS-only keys
# (macos-*) are inert on Linux, so they are safe in this shared file.

# --- Appearance -------------------------------------------------------------

# Catppuccin Mocha is one of Ghostty's 300+ built-in themes (`ghostty +list-themes`).
# Deliberately diverges from kitty's Dracula (config/kitty/current-theme.conf).
theme = Catppuccin Mocha

# MesloLGS NF is powerlevel10k's recommended font (installed by `p10k configure`).
# It is single-width, which is required by POWERLEVEL9K_ICON_PADDING=none in
# shell/p10k.default.zsh so prompt icons occupy exactly one cell.
# Repeated font-family lines are fallbacks, tried in order: JetBrainsMono NF
# covers glyphs Meslo lacks; Apple SD Gothic Neo renders Korean (macOS system
# font — absent on Linux, where Ghostty skips it and fontconfig takes over).
font-family = MesloLGS NF
font-family = JetBrainsMono Nerd Font
font-family = Apple SD Gothic Neo
font-size = 13

# 0 = fully transparent, 1 = opaque.
background-opacity = 0.8
# Blur what's behind the transparent background (macOS and KDE; no-op elsewhere).
background-blur = true

# kitty window_padding_width 4 (points, DPI-scaled).
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

# --- Cursor -----------------------------------------------------------------

cursor-style = block
# kitty cursor_blink_interval -1 (never blink).
cursor-style-blink = false

# --- Behavior ---------------------------------------------------------------

# `clipboard` (not `true`) so selected text lands in the system clipboard and
# ctrl+v pastes it — matches kitty's copy_on_select yes.
copy-on-select = clipboard

mouse-hide-while-typing = true

# Start maximized, like kitty's os_window_state maximized (Ghostty >= 1.1.0).
maximize = true

# Option acts as Alt/Meta (zsh word motions, TUI alt bindings). macOS-only key.
macos-option-as-alt = true

# scrollback-limit is in BYTES (default 10 MB), unlike kitty's 10000 lines.
# The default already far exceeds 10000 lines, so it is left unset.

# --- Keybindings ------------------------------------------------------------
# ctrl+shift+c / ctrl+shift+v are already the Linux defaults; setting them here
# makes copy/paste consistent on macOS too (alongside the default cmd+c/cmd+v).
keybind = f11=toggle_fullscreen
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
# Ghostty's macOS defaults map alt+left/right to esc+b/esc+f word jumps, which
# swallows the keys before Zellij sees them; unbind so Zellij navigation works.
keybind = alt+left=unbind
keybind = alt+right=unbind

# --- SSH / terminfo ----------------------------------------------------------
# Ghostty advertises TERM=xterm-ghostty, whose terminfo is missing on remote
# hosts without Ghostty (garbled keys/colors over SSH — macOS ships no
# xterm-ghostty entry in /usr/share/terminfo). Local sessions are unaffected;
# these features only kick in when running `ssh` from inside Ghostty:
#   ssh-terminfo — auto-install Ghostty's terminfo on the remote via tic
#   ssh-env      — otherwise fall back to TERM=xterm-256color for that session
# Unlisted features (cursor, title, ...) keep their defaults. Requires >= 1.2.
shell-integration-features = ssh-env,ssh-terminfo
# Last-resort global fallback (loses Ghostty-specific capabilities locally):
# term = xterm-256color
